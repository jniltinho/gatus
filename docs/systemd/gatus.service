# systemd unit of Gatus installed from the release tarball in /opt/gatus. See docs/install-linux.md.
#
#   /opt/gatus/gatus                the binary
#   /opt/gatus/config/config.yaml   the configuration (a directory of YAML files also works)
#   /opt/gatus/data/                the SQLite database, when storage.path points here

[Unit]
Description=Gatus - health dashboard and status pages
Documentation=https://github.com/jniltinho/gatus/tree/master/docs
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gatus
Group=gatus
WorkingDirectory=/opt/gatus
Environment=GATUS_LOG_LEVEL=INFO

# Gatus logs to the standard output, which goes to the journal: journalctl -u gatus. To also keep a file, see "Logs" in
# docs/install-linux.md.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gatus

# An invalid configuration keeps the previous process from being replaced by one that would not start
ExecStartPre=/opt/gatus/gatus config validate --config /opt/gatus/config/config.yaml
ExecStart=/opt/gatus/gatus --config /opt/gatus/config/config.yaml

# Gatus reloads the configuration by itself when the file changes: there is no ExecReload on purpose
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# ICMP endpoints (ping) need a raw socket, which a user other than root only gets through this capability
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

# The service only writes in /opt/gatus/data
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/gatus/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
